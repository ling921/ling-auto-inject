<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;</TargetFrameworks>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_AddAnalyzer</TargetsForTfmSpecificBuildOutput>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>.nuget</PackageOutputPath>
    <PackageId>Ling.AutoInject.Options</PackageId>
    <Authors>ling921</Authors>
    <Description>Options registration contracts for Ling.AutoInject.</Description>
    <PackageTags>ling;dependency-injection;options;configuration;sourcegenerator;analyzers;</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.4.0</PackageValidationBaselineVersion>
    <RepositoryUrl>https://github.com/ling921/ling-auto-inject</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ling.AutoInject\Ling.AutoInject.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed" />
    <ProjectReference Include="..\Ling.AutoInject.SourceGenerators\Ling.AutoInject.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>
  <Target Name="_AddAnalyzer" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PropertyGroup>
      <GeneratorOutDir>$(ProjectDir)..\Ling.AutoInject.SourceGenerators\bin\$(Configuration)\netstandard2.0\</GeneratorOutDir>
      <GeneratorDll>$(GeneratorOutDir)Ling.AutoInject.SourceGenerators.dll</GeneratorDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(GeneratorDll)')" Text="Build the source generator before packing Ling.AutoInject.Options." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(GeneratorDll)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(GeneratorOutDir)**\*.resources.dll" PackagePath="analyzers/dotnet/cs/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.zh-CN.md" Pack="true" PackagePath="" />
    <None Include="..\..\assets\icon.png" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
